{
  "expo": {
    "name": "Wetriva",
    "slug": "wetriva",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "wetriva",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#1B0745",
      "image": "./assets/images/icon.png",
      "resizeMode": "contain"
    },
    "ios": {
      "bundleIdentifier": "com.wetriva.app",
      "supportsTablet": false
    },
    "android": {
      "package": "com.wetriva.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#1B0745"
      }
    },
    "web": {
      "favicon": "./assets/images/icon.png",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "يحتاج ويتريفا إلى الوصول إلى صورك لإضافة صورة للغرض.",
          "cameraPermission": "يحتاج ويتريفا إلى استخدام الكاميرا لتصوير الغرض.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#7CFF4F",
          "defaultChannel": "default"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
